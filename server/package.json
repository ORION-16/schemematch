{
  "name": "schemematch-server",
  "version": "1.0.0",
  "description": "SchemeMatch Express API server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node data/seedSchemes.js",
    "install-all": "npm install --prefix . && npm install --prefix ../client --legacy-peer-deps",
    "build": "npm run build --prefix ../client",
    "dev": "node server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "puppeteer": "^25.12.0"
  }
}
